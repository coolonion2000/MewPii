{
  "name": "mewpii",
  "version": "0.1.0",
  "private": true,
  "description": "MewPii — a dsh-styled web UI for the pi coding agent",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "node server/dist/index.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "bin": {
    "mewpii": "server/bin/mewpii.js",
    "pii-web": "server/bin/mewpii.js"
  },
  "files": [
    "server/dist",
    "server/bin",
    "web/dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}